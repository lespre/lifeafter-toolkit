def _under(root: Path, allowed) -> bool:
    """路径是否落在允许的根下（不依赖 os：统一分隔符后按前缀比）。"""
    s = str(root).replace("/", "\\").lower().rstrip("\\")
    for a in allowed:
        a = a.lower().rstrip("\\")
        if s == a or s.startswith(a + "\\"):
            return True
    return False


